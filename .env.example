# ==============================================================================
# VisionTrack AI - Environment Configuration Variables
# ==============================================================================

# Django Secret & Debug
DJANGO_SECRET_KEY=change-this-in-production-to-a-secure-random-64-char-string
DJANGO_DEBUG=True
ALLOWED_HOSTS=*

# Database Engine ('postgres' or 'sqlite')
DB_ENGINE=postgres
POSTGRES_DB=visiontrack
POSTGRES_USER=visiontrack
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis & Celery
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_ALWAYS_EAGER=False
USE_REDIS_CHANNEL=True

# AI Inference & Hardware
CUDA_VISIBLE_DEVICES=0
DEFAULT_DETECTION_MODEL=yolov8n
DEFAULT_TRACKER=bytetrack
DEFAULT_REID_THRESHOLD=0.85
